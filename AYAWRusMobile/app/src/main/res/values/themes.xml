<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AYAWrusMobileJava" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Window chrome -->
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>

        <!-- Primary = cyan accent -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/surface_raised</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="colorTertiary">@color/status_info</item>
        <item name="colorOnTertiary">@color/on_accent</item>

        <item name="colorError">@color/status_threat</item>
        <item name="colorOnError">@color/on_accent</item>
        <item name="colorErrorContainer">@color/status_threat_fill</item>
        <item name="colorOnErrorContainer">@color/status_threat</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/bg_deep</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/surface_raised</item>

        <!-- Outlines -->
        <item name="colorOutline">@color/stroke_card</item>
        <item name="colorOutlineVariant">@color/stroke_card</item>

        <!-- Bottom sheets -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.AYAWrus.BottomSheetDialog</item>
    </style>

    <style name="Theme.AYAWrusMobileJava" parent="Base.Theme.AYAWrusMobileJava" />

    <!-- Mono text style: use via android:textAppearance="@style/TextAppearance.AYAWrus.Mono" -->
    <style name="TextAppearance.AYAWrus.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <!-- Toolbar: light icons/title on the gradient -->
    <style name="ThemeOverlay.AYAWrus.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AYAWrus.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AYAWrus.NavItem" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="ThemeOverlay.AYAWrus.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.AYAWrus.BottomSheet</item>
    </style>

    <style name="Widget.AYAWrus.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/bg_mid</item>
    </style>
</resources>