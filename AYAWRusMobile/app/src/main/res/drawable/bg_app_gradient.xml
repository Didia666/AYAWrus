<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/bg_light"
                android:centerColor="@color/bg_mid"
                android:endColor="@color/bg_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="70%p"
                android:startColor="@color/bg_glow"
                android:endColor="@color/transparent" />
        </shape>
    </item>
</layer-list>