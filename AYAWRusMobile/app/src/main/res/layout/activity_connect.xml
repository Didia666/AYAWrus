<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="AYAWrus shield"
        android:padding="16dp"
        android:background="@drawable/bg_card"
        android:src="@drawable/ic_shield"
        app:tint="@color/accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center"
        android:text="Connect to AYAWrus"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Scan the QR code from the AYAWrus laptop."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnectToAyawrus"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:fontFamily="@font/jetbrains_mono"
        android:text="Scan QR Code"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/accent"
        app:cornerRadius="@dimen/button_corner_radius" />

</LinearLayout>